generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Aluno {
  ra            String         @id @db.VarChar(8)
  nome          String         @db.VarChar(255)
  curso         String         @db.VarChar(100)
  senha         String?        @db.VarChar(255)
  apto          Boolean        @default(true)
  candidaturas  Candidatura[]
  notificacoes  Notificacao[]

  @@map("alunos")
}

model Empresa {
  id          BigInt   @id @default(autoincrement())
  razaoSocial String   @map("razao_social") @db.VarChar(255)
  cnpj        String   @unique(map: "cnpj") @db.VarChar(18)
  email       String   @db.VarChar(255)
  telefone    String?  @db.VarChar(20)
  senha       String?  @db.VarChar(255)
  aprovada    Boolean? @default(false)
  vagas       Vaga[]

  @@map("empresas")
}

model Vaga {
  id           BigInt        @id @default(autoincrement())
  titulo       String        @db.VarChar(255)
  descricao    String        @db.Text
  bolsa        Decimal?      @db.Decimal(10, 2)
  empresaId    BigInt        @map("empresa_id")
  ativa        Boolean?      @default(true)
  candidaturas Candidatura[]
  empresa      Empresa       @relation(fields: [empresaId], references: [id], onUpdate: Restrict, map: "vagas_ibfk_1")

  @@index([empresaId], map: "empresa_id")
  @@map("vagas")
}

model Candidatura {
  id      BigInt  @id @default(autoincrement())
  alunoRa String  @map("aluno_ra") @db.VarChar(8)
  vagaId  BigInt  @map("vaga_id")
  status  String? @default("Pendente") @db.VarChar(50)
  aluno   Aluno   @relation(fields: [alunoRa], references: [ra], onUpdate: Restrict, map: "candidaturas_ibfk_1")
  vaga    Vaga    @relation(fields: [vagaId], references: [id], onUpdate: Restrict, map: "candidaturas_ibfk_2")

  @@index([alunoRa], map: "aluno_ra")
  @@index([vagaId], map: "vaga_id")
  @@map("candidaturas")
}

model Usuario {
  id     BigInt @id @default(autoincrement())
  nome   String @db.VarChar(100)
  login  String @unique(map: "login") @db.VarChar(50)
  senha  String @db.VarChar(255)
  perfil String @db.VarChar(20)

  @@map("usuarios")
}

model Notificacao {
  id        BigInt   @id @default(autoincrement())
  alunoRa   String   @map("aluno_ra") @db.VarChar(8)
  mensagem  String   @db.VarChar(500)
  lida      Boolean  @default(false)
  criadaEm  DateTime @default(now()) @map("criada_em")
  aluno     Aluno    @relation(fields: [alunoRa], references: [ra], onDelete: Cascade)

  @@index([alunoRa], map: "aluno_ra")
  @@map("notificacoes")
}
